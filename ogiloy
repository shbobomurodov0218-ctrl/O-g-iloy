<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>O‘g‘iloy: Neon Gift Runner</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #050010;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* Portrait Warning Overlay */
        #portrait-warning {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 0, 20, 0.95);
            z-index: 9999;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ff007f;
            text-align: center;
            padding: 20px;
            box-shadow: inset 0 0 50px #ff007f;
        }

        #portrait-warning .phone-icon {
            font-size: 60px;
            margin-bottom: 20px;
            animation: rotatePhone 2s infinite ease-in-out;
        }

        @keyframes rotatePhone {
            0% { transform: rotate(0deg); }
            50% { transform: rotate(-90deg); }
            100% { transform: rotate(0deg); }
        }

        /* UI Controls Overlay */
        .controls-layer {
            position: absolute;
            bottom: 15px;
            left: 0;
            width: 100%;
            height: 90px;
            display: flex;
            justify-content: space-between;
            padding: 0 25px;
            pointer-events: none;
            z-index: 10;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            pointer-events: auto;
        }

        .btn {
            background: rgba(255, 0, 127, 0.25);
            border: 2px solid #ff007f;
            color: #fff;
            font-weight: bold;
            font-size: 16px;
            padding: 12px 22px;
            border-radius: 15px;
            box-shadow: 0 0 15px #ff007f, inset 0 0 10px #ff007f;
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.1s, background 0.1s;
        }

        .btn:active {
            transform: scale(0.92);
            background: rgba(255, 0, 127, 0.6);
        }

        .btn-jump {
            pointer-events: auto;
            background: rgba(255, 215, 0, 0.25);
            border-color: #ffd700;
            box-shadow: 0 0 15px #ffd700, inset 0 0 10px #ffd700;
            width: 110px;
        }

        .btn-jump:active {
            background: rgba(255, 215, 0, 0.6);
        }

        /* End Screen Overlay */
        #end-screen {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.75);
            z-index: 100;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(8px);
        }

        .congrat-title {
            color: #ff007f;
            font-size: 5vw;
            font-weight: 900;
            text-shadow: 0 0 20px #ff007f, 0 0 40px #ff007f, 0 0 60px #ff00ff;
            text-align: center;
            margin-bottom: 10px;
            animation: pulseGlow 1.5s infinite alternate;
        }

        .congrat-sub {
            color: #ffd700;
            font-size: 3.5vw;
            font-weight: bold;
            text-shadow: 0 0 15px #ffd700;
            margin-bottom: 25px;
        }

        @keyframes pulseGlow {
            0% { transform: scale(0.98); text-shadow: 0 0 15px #ff007f; }
            100% { transform: scale(1.03); text-shadow: 0 0 35px #ff007f, 0 0 50px #ff00ff; }
        }

        .restart-btn {
            pointer-events: auto;
            background: #ff007f;
            color: #fff;
            font-size: 20px;
            font-weight: bold;
            padding: 15px 40px;
            border: none;
            border-radius: 30px;
            box-shadow: 0 0 25px #ff007f;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .restart-btn:hover {
            transform: scale(1.08);
        }
    </style>
</head>
<body>

    <div id="game-container">
        <!-- Portrait Warning -->
        <div id="portrait-warning">
            <div class="phone-icon">📱🔄</div>
            <h2>Iltimos, o‘yinni davom ettirish uchun telefonni yonboshga (gorizontal) o‘giring!</h2>
        </div>

        <!-- Canvas Game -->
        <canvas id="gameCanvas"></canvas>

        <!-- Touch Controls -->
        <div class="controls-layer">
            <div class="btn-group">
                <div class="btn" id="btn-left">◀ ORQAGA</div>
                <div class="btn" id="btn-right">OLDINGA ▶</div>
            </div>
            <div class="btn btn-jump" id="btn-jump">▲ SAKRASH</div>
        </div>

        <!-- Win / End Game Screen -->
        <div id="end-screen">
            <div class="congrat-title">Tug‘ilgan kuning bilan, O‘g‘iloy!</div>
            <div class="congrat-sub">🎉 2 yoshga to‘lding! 🎉</div>
            <button class="restart-btn" id="restart-btn">Qayta O‘ynash 🔄</button>
        </div>
    </div>

    <script>
        // Web Audio API Sound Effects
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) audioCtx = new AudioCtx();
        }

        function playSound(type) {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === 'jump') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.exponentialRampToValueAtTime(400, now + 0.15);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
                osc.start(now);
                osc.stop(now + 0.15);
            } else if (type === 'collect') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
                osc.frequency.setValueAtTime(783.99, now + 0.16); // G5
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
                osc.start(now);
                osc.stop(now + 0.25);
            } else if (type === 'win') {
                const notes = [261.63, 329.63, 392.00, 523.25];
                notes.forEach((freq, idx) => {
                    const noteOsc = audioCtx.createOscillator();
                    const noteGain = audioCtx.createGain();
                    noteOsc.connect(noteGain);
                    noteOsc.connect(audioCtx.destination);
                    noteOsc.frequency.setValueAtTime(freq, now + idx * 0.12);
                    noteGain.gain.setValueAtTime(0.25, now + idx * 0.12);
                    noteGain.gain.linearRampToValueAtTime(0.01, now + idx * 0.12 + 0.3);
                    noteOsc.start(now + idx * 0.12);
                    noteOsc.stop(now + idx * 0.12 + 0.3);
                });
            }
        }

        // Game Variables
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let bgImage = new Image();
        bgImage.src = 'bg.jpg'; // Expects photo in root folder

        let gameTime = 60; // 1 minute
        let score = 0;
        let isGameOver = false;
        let isPaused = false;

        const keys = { left: false, right: false, jump: false };

        const player = {
            x: 100,
            y: 0,
            width: 45,
            height: 75,
            vx: 0,
            vy: 0,
            speed: 5,
            gravity: 0.6,
            jumpPower: -13,
            isGrounded: false,
            animTimer: 0,
            direction: 1
        };

        let items = [];
        let particles = [];
        let fireworks = [];
        let itemSpawnTimer = 0;

        const itemTypes = ['🎁', '🧸', '⭐', '🎂', '🎈'];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            checkOrientation();
        }

        function checkOrientation() {
            const warning = document.getElementById('portrait-warning');
            if (window.innerHeight > window.innerWidth) {
                warning.style.display = 'flex';
                isPaused = true;
            } else {
                warning.style.display = 'none';
                isPaused = false;
            }
        }

        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('load', () => {
            resizeCanvas();
            resetGame();
            requestAnimationFrame(gameLoop);
        });

        // Touch Control Listeners
        function bindTouch(elementId, keyName) {
            const el = document.getElementById(elementId);
            const start = (e) => { e.preventDefault(); initAudio(); keys[keyName] = true; };
            const end = (e) => { e.preventDefault(); keys[keyName] = false; };
            el.addEventListener('touchstart', start);
            el.addEventListener('touchend', end);
            el.addEventListener('mousedown', start);
            el.addEventListener('mouseup', end);
        }

        bindTouch('btn-left', 'left');
        bindTouch('btn-right', 'right');
        bindTouch('btn-jump', 'jump');

        document.getElementById('restart-btn').addEventListener('click', () => {
            document.getElementById('end-screen').style.display = 'none';
            resetGame();
        });

        function resetGame() {
            gameTime = 60;
            score = 0;
            isGameOver = false;
            player.x = 100;
            player.y = canvas.height - 180;
            player.vx = 0;
            player.vy = 0;
            items = [];
            particles = [];
            fireworks = [];
            itemSpawnTimer = 0;
        }

        // Spawn Gifts
        function spawnItem() {
            const groundY = canvas.height - 100;
            items.push({
                x: canvas.width + 30,
                y: groundY - 40 - Math.random() * 80,
                type: itemTypes[Math.floor(Math.random() * itemTypes.length)],
                size: 35,
                collected: false
            });
        }

        // Particle Explosion
        function createParticles(x, y, color) {
            for (let i = 0; i < 12; i++) {
                particles.push({
                    x, y,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.5) * 8,
                    size: Math.random() * 6 + 2,
                    color: color,
                    alpha: 1
                });
            }
        }

        // Fireworks for Win Sequence
        function createFirework() {
            const x = Math.random() * canvas.width;
            const y = Math.random() * (canvas.height / 2);
            const colors = ['#ff007f', '#ffd700', '#00ffff', '#ff00ff', '#ffffff'];
            const color = colors[Math.floor(Math.random() * colors.length)];
            for (let i = 0; i < 30; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                fireworks.push({
                    x, y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    color: color,
                    alpha: 1
                });
            }
        }

        // Main Timer Loop (1 minute)
        setInterval(() => {
            if (!isGameOver && !isPaused) {
                if (gameTime > 0) {
                    gameTime--;
                    if (gameTime === 0) {
                        endGame();
                    }
                }
            }
        }, 1000);

        function endGame() {
            isGameOver = true;
            playSound('win');
            document.getElementById('end-screen').style.display = 'flex';
        }

        // Game Loop
        let lastTime = performance.now();
        function gameLoop(currentTime) {
            const dt = (currentTime - lastTime) / 1000;
            lastTime = currentTime;

            if (!isPaused) {
                update();
                render();
            }

            requestAnimationFrame(gameLoop);
        }

        function update() {
            const groundY = canvas.height - 100;

            if (!isGameOver) {
                // Movement Logic
                if (keys.left) {
                    player.vx = -player.speed;
                    player.direction = -1;
                    player.animTimer += 0.2;
                } else if (keys.right) {
                    player.vx = player.speed;
                    player.direction = 1;
                    player.animTimer += 0.2;
                } else {
                    player.vx = 0;
                    player.animTimer = 0;
                }

                // Jump Logic
                if (keys.jump && player.isGrounded) {
                    player.vy = player.jumpPower;
                    player.isGrounded = false;
                    playSound('jump');
                }

                // Physics
                player.x += player.vx;
                player.vy += player.gravity;
                player.y += player.vy;

                // Screen boundaries
                if (player.x < 10) player.x = 10;
                if (player.x > canvas.width - player.width - 10) player.x = canvas.width - player.width - 10;

                if (player.y >= groundY - player.height) {
                    player.y = groundY - player.height;
                    player.vy = 0;
                    player.isGrounded = true;
                }

                // Spawn Items sequentially
                itemSpawnTimer++;
                if (itemSpawnTimer > 70 && gameTime > 2) {
                    spawnItem();
                    itemSpawnTimer = 0;
                }

                // Update Items
                items.forEach(item => {
                    item.x -= 2.5; // Scroll left

                    // Collision with Player
                    if (!item.collected &&
                        player.x < item.x + item.size &&
                        player.x + player.width > item.x &&
                        player.y < item.y + item.size &&
                        player.y + player.height > item.y) {
                        
                        item.collected = true;
                        score += 100;
                        playSound('collect');
                        createParticles(item.x, item.y, '#ffd700');
                    }
                });

                items = items.filter(item => item.x > -50 && !item.collected);
            }

            // Update Particles
            particles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.03;
            });
            particles = particles.filter(p => p.alpha > 0);

            // Update Fireworks on Win
            if (isGameOver) {
                if (Math.random() < 0.1) createFirework();
                fireworks.forEach(f => {
                    f.x += f.vx;
                    f.y += f.vy;
                    f.alpha -= 0.02;
                });
                fireworks = fireworks.filter(f => f.alpha > 0);
            }
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const groundY = canvas.height - 100;

            // 1. Draw Background Image
            if (bgImage.complete && bgImage.naturalWidth !== 0) {
                ctx.drawImage(bgImage, 0, 0, canvas.width, canvas.height);
                // Soft pink/purple neon tint overlay
                ctx.fillStyle = 'rgba(20, 0, 30, 0.35)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            } else {
                ctx.fillStyle = '#120024';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            }

            // 2. Draw Neon Ground Track
            ctx.shadowBlur = 15;
            ctx.shadowColor = '#ff007f';
            ctx.strokeStyle = '#ff007f';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(0, groundY);
            ctx.lineTo(canvas.width, groundY);
            ctx.stroke();
            ctx.shadowBlur = 0;

            // 3. Draw Collectible Items
            items.forEach(item => {
                ctx.font = '32px sans-serif';
                ctx.shadowBlur = 10;
                ctx.shadowColor = '#ffd700';
                ctx.fillText(item.type, item.x, item.y + 30);
                ctx.shadowBlur = 0;
            });

            // 4. Draw Animated Player (O'g'iloy)
            drawPlayer(ctx, player, groundY);

            // 5. Draw Particles
            particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // 6. Draw Fireworks
            fireworks.forEach(f => {
                ctx.save();
                ctx.globalAlpha = f.alpha;
                ctx.fillStyle = f.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = f.color;
                ctx.beginPath();
                ctx.arc(f.x, f.y, 3, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // 7. Top UI Bar
            ctx.fillStyle = 'rgba(10, 0, 20, 0.6)';
            ctx.fillRect(0, 0, canvas.width, 50);

            ctx.font = 'bold 20px Segoe UI';
            ctx.fillStyle = '#ffd700';
            ctx.shadowBlur = 8;
            ctx.shadowColor = '#ffd700';
            
            // Timer
            const formattedTime = gameTime < 10 ? `0${gameTime}` : gameTime;
            ctx.fillText(`⏱️ 00:${formattedTime}`, 20, 32);
            
            // Score
            ctx.fillText(`🏆 SCORE: ${score}`, canvas.width / 2 - 60, 32);

            // Badge
            ctx.fillStyle = '#ff007f';
            ctx.shadowColor = '#ff007f';
            ctx.fillText(`🎀 O‘G‘ILOY - 2 YOSH`, canvas.width - 230, 32);
            ctx.shadowBlur = 0;
        }

        function drawPlayer(ctx, p, groundY) {
            ctx.save();
            ctx.translate(p.x + p.width / 2, p.y + p.height / 2);
            if (p.direction === -1) ctx.scale(-1, 1);

            const legAngle = Math.sin(p.animTimer) * 0.6;
            const armAngle = -Math.sin(p.animTimer) * 0.6;

            ctx.shadowBlur = 12;
            ctx.shadowColor = '#ff007f';

            // Left Leg
            ctx.strokeStyle = '#ff007f';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.moveTo(0, 10);
            ctx.lineTo(Math.sin(-legAngle) * 15, 35);
            ctx.stroke();

            // Right Leg
            ctx.beginPath();
            ctx.moveTo(0, 10);
            ctx.lineTo(Math.sin(legAngle) * 15, 35);
            ctx.stroke();

            // Body (Dress/Suit)
            ctx.fillStyle = '#ff007f';
            ctx.beginPath();
            ctx.moveTo(-12, -10);
            ctx.lineTo(12, -10);
            ctx.lineTo(16, 15);
            ctx.lineTo(-16, 15);
            ctx.closePath();
            ctx.fill();

            // Left Arm
            ctx.beginPath();
            ctx.moveTo(-5, -5);
            ctx.lineTo(-5 + Math.sin(-armAngle) * 12, 10);
            ctx.stroke();

            // Right Arm
            ctx.beginPath();
            ctx.moveTo(5, -5);
            ctx.lineTo(5 + Math.sin(armAngle) * 12, 10);
            ctx.stroke();

            // Head & Scarf (Hijab/Hat style)
            ctx.fillStyle = '#ffb6c1';
            ctx.beginPath();
            ctx.arc(0, -22, 12, 0, Math.PI * 2);
            ctx.fill();

            // Scarf / Hood (Striped pattern)
            ctx.fillStyle = '#ff007f';
            ctx.beginPath();
            ctx.arc(0, -24, 15, Math.PI, Math.PI * 2);
            ctx.fill();

            // Face Name Tag
            ctx.font = 'bold 11px sans-serif';
            ctx.fillStyle = '#ffffff';
            ctx.shadowBlur = 5;
            ctx.shadowColor = '#000';
            ctx.fillText("O'g'iloy", -18, -42);

            ctx.restore();
        }
    </script>
</body>
</html>
